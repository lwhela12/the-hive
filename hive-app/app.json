{
  "expo": {
    "name": "Legacy HIVE 2027",
    "slug": "hive-legacy-2027",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/HIVE Logo Low Res.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "hivelegacy2027",
    "splash": {
      "image": "./assets/HIVE Total transparent background.png",
      "resizeMode": "contain",
      "backgroundColor": "#BD9348"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lucaswhelan.hivelegacy2027",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "HIVE needs camera access to take profile photos and attach images to posts and messages.",
        "NSMicrophoneUsageDescription": "HIVE needs microphone access to record meetings.",
        "NSPhotoLibraryAddUsageDescription": "HIVE needs photo library access to save photos you create in the app.",
        "NSPhotoLibraryUsageDescription": "HIVE needs photo library access to upload profile photos and attach images to posts and messages.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "notification": {
      "icon": "./assets/HIVE Bee.png",
      "color": "#BD9348"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/HIVE Bee.png",
        "backgroundColor": "#BD9348"
      },
      "package": "com.lucaswhelan.hivelegacy2027",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/hive-favicon.png",
      "bundler": "metro",
      "name": "Legacy HIVE 2027",
      "shortName": "Legacy 2027",
      "backgroundColor": "#BD9348"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Allow HIVE to access your microphone for recording meetings."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/HIVE Bee.png",
          "color": "#BD9348"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HIVE needs photo library access to upload profile photos and attach images to posts and messages.",
          "cameraPermission": "HIVE needs camera access to take profile photos and attach images to posts and messages."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "hiveVintage": {
        "codeBranch": "legacy-2027",
        "year": 2027,
        "backendConfigured": false,
        "launchStatus": "not-deployed"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    }
  }
}
