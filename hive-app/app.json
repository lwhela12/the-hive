{
  "expo": {
    "name": "H.I.V.E.",
    "slug": "the-hive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/HIVE Logo Low Res.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "thehive",
    "splash": {
      "image": "./assets/HIVE Total transparent background.png",
      "resizeMode": "contain",
      "backgroundColor": "#bd9348"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lucaswhelan.thehive",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "H.I.V.E. needs camera access to take profile photos and attach images to posts and messages.",
        "NSMicrophoneUsageDescription": "H.I.V.E. needs microphone access to record meetings.",
        "NSPhotoLibraryAddUsageDescription": "H.I.V.E. needs photo library access to save photos you create in the app.",
        "NSPhotoLibraryUsageDescription": "H.I.V.E. needs photo library access to upload profile photos and attach images to posts and messages.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "notification": {
      "icon": "./assets/HIVE Bee.png",
      "color": "#bd9348"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/HIVE Bee.png",
        "backgroundColor": "#bd9348"
      },
      "package": "com.lucaswhelan.thehive",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/BEE ONLY IN GOLD BG.png",
      "bundler": "metro",
      "name": "H.I.V.E.",
      "shortName": "HIVE",
      "themeColor": "#bd9348",
      "backgroundColor": "#bd9348"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Allow H.I.V.E. to access your microphone for recording meetings."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/HIVE Bee.png",
          "color": "#bd9348"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "H.I.V.E. needs photo library access to upload profile photos and attach images to posts and messages.",
          "cameraPermission": "H.I.V.E. needs camera access to take profile photos and attach images to posts and messages."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "20097652-8224-4286-aa03-5d7f4f3c0991"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/20097652-8224-4286-aa03-5d7f4f3c0991",
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    }
  }
}
