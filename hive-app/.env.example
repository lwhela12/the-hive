# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx  # Server-side only (Edge Functions)

# Claude
ANTHROPIC_API_KEY=sk-ant-xxx

# AssemblyAI
ASSEMBLYAI_API_KEY=xxx

# Google (for Calendar integration)
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx

# Resend (Email)
RESEND_API_KEY=re_xxx
FROM_EMAIL=The HIVE <hive@yourdomain.com>

# App
EXPO_PUBLIC_APP_URL=https://thehive.app

# Release gate: leave false until HIVE's verified sender, email-code delivery,
# account linking, and a real member sign-in have been checked on both the
# website and an installed shortcut.
# are complete. Only the literal value true exposes the email-code door.
EXPO_PUBLIC_EMAIL_AUTH_ENABLED=false
